# Ensure pnpm is used; block npm and yarn to avoid lockfile conflicts.
engine-strict=true
# Hoist packages to node_modules/.pnpm for tooling compatibility.
shamefully-hoist=false
# Strict peer dependency resolution.
strict-peer-dependencies=false
# Prefer frozen lockfile in CI.
# frozen-lockfile=true  # Enable in CI via --frozen-lockfile flag instead.
