// @ts-check
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  ASSET_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
  AUDITOR
}

enum MembershipStatus {
  PENDING
  ACTIVE
  OFFBOARDING
  INACTIVE
}

enum AssetLifecycleState {
  ACTIVE
  LOST
  RETIRED
  DISPOSED
}

enum AssetCustodyState {
  UNALLOCATED
  ALLOCATED
}

enum AssetServiceabilityState {
  OPERATIONAL
  UNDER_MAINTENANCE
}

enum AssetReservationState {
  NONE
  RESERVED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  BROKEN
}

enum HolderType {
  EMPLOYEE
  DEPARTMENT
}

enum AllocationStatus {
  ACTIVE
  RETURN_REQUESTED
  CLOSED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  AWAITING_HANDOVER
  HANDOVER_CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ReturnStatus {
  RETURN_REQUESTED
  AWAITING_INSPECTION
  ACCEPTED
  ACCEPTED_WITH_DAMAGE
  REJECTED_FOR_CORRECTION
  CANCELLED
}

enum ResourceType {
  ROOM
  VEHICLE
  EQUIPMENT
  WORKSPACE
  ASSET_BACKED
}

enum BookingStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  NO_SHOW
  ACTION_REQUIRED
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  TECHNICIAN_ASSIGNED
  IN_PROGRESS
  RESOLVED
  UNREPAIRABLE
  REJECTED
  CANCELLED
}

enum AuditCycleStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  REVIEW
  CLOSED
  CANCELLED
}

enum AuditItemResult {
  VERIFIED
  MISSING
  DAMAGED
  WRONG_LOCATION
  WRONG_HOLDER
  NOT_ACCESSIBLE
  NOT_APPLICABLE
  UNEXPECTED_ASSET
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTERED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ExportJobStatus {
  REQUESTED
  PROCESSING
  READY
  EXPIRED
  FAILED
}

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  timezone    String
  locale      String   @default("en")
  dateFormat  String   @default("yyyy-MM-dd")
  workingWeek Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash   String?   @map("password_hash")
  sessionVersion Int       @default(1) @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([email])
  @@map("users")
}

model TenantMembership {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  employeeId String?          @map("employee_id") @db.Uuid
  status     MembershipStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model RoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleCode     RoleCode @map("role_code")
  scopeType    String   @map("scope_type")
  scopeId      String?  @map("scope_id") @db.Uuid
  assignedBy   String   @map("assigned_by") @db.Uuid
  reason       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([tenantId, membershipId])
  @@index([tenantId, roleCode])
  @@map("role_assignments")
}

model Employee {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  email        String
  displayName  String           @map("display_name")
  departmentId String?          @map("department_id") @db.Uuid
  status       MembershipStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime?        @map("archived_at") @db.Timestamptz(6)

  @@unique([tenantId, email])
  @@index([tenantId, departmentId])
  @@map("employees")
}

model Department {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  parentDepartmentId String?   @map("parent_department_id") @db.Uuid
  name               String
  code               String
  status             String    @default("ACTIVE")
  headEmployeeId     String?   @map("head_employee_id") @db.Uuid
  locationId         String?   @map("location_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@index([tenantId, parentDepartmentId])
  @@map("departments")
}

model Location {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  code       String
  address    String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("locations")
}

model AssetCategory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  code          String
  currentSchema Int      @default(1) @map("current_schema")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("asset_categories")
}

model AssetCategorySchemaVersion {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  version    Int
  jsonSchema Json     @map("json_schema")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([categoryId, version])
  @@index([tenantId, categoryId])
  @@map("asset_category_schema_versions")
}

model Asset {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  assetTag           String                   @map("asset_tag")
  name               String
  categoryId         String                   @map("category_id") @db.Uuid
  categorySchema     Int                      @default(1) @map("category_schema")
  serialNumber       String?                  @map("serial_number")
  acquisitionDate    DateTime?                @map("acquisition_date") @db.Date
  acquisitionCost    Decimal?                 @map("acquisition_cost") @db.Decimal(14, 2)
  condition          AssetCondition           @default(GOOD)
  primaryLocationId  String                   @map("primary_location_id") @db.Uuid
  owningDepartmentId String?                  @map("owning_department_id") @db.Uuid
  isBookable         Boolean                  @default(false) @map("is_bookable")
  criticality        String                   @default("NORMAL")
  warrantyEnd        DateTime?                @map("warranty_end") @db.Date
  lifecycleState     AssetLifecycleState      @default(ACTIVE) @map("lifecycle_state")
  custodyState       AssetCustodyState        @default(UNALLOCATED) @map("custody_state")
  serviceability     AssetServiceabilityState @default(OPERATIONAL)
  reservationState   AssetReservationState    @default(NONE) @map("reservation_state")
  attributes         Json                     @default("{}")
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?                @map("archived_at") @db.Timestamptz(6)

  @@unique([tenantId, assetTag])
  @@index([tenantId, lifecycleState, custodyState])
  @@index([tenantId, categoryId])
  @@map("assets")
}

model AssetStateHistory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  reason        String
  beforeSummary Json     @map("before_summary")
  afterSummary  Json     @map("after_summary")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, assetId, createdAt])
  @@map("asset_state_history")
}

model AssetDocument {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  assetId         String    @map("asset_id") @db.Uuid
  objectKey       String    @map("object_key")
  fileName        String    @map("file_name")
  mimeType        String    @map("mime_type")
  byteSize        Int       @map("byte_size")
  sha256          String
  quarantineState String    @default("PENDING") @map("quarantine_state")
  uploadedBy      String    @map("uploaded_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)

  @@index([tenantId, assetId])
  @@map("asset_documents")
}

model Allocation {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  assetId          String           @map("asset_id") @db.Uuid
  holderType       HolderType       @map("holder_type")
  holderId         String           @map("holder_id") @db.Uuid
  status           AllocationStatus @default(ACTIVE)
  expectedReturnAt DateTime?        @map("expected_return_at") @db.Timestamptz(6)
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt         DateTime?        @map("closed_at") @db.Timestamptz(6)
  version          Int              @default(1)
  createdBy        String           @map("created_by") @db.Uuid
  notes            String?

  @@index([tenantId, assetId, status])
  @@index([tenantId, holderType, holderId])
  @@map("allocations")
}

model TransferRequest {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  assetId          String         @map("asset_id") @db.Uuid
  sourceAllocationId String       @map("source_allocation_id") @db.Uuid
  targetHolderType HolderType     @map("target_holder_type")
  targetHolderId   String         @map("target_holder_id") @db.Uuid
  status           TransferStatus @default(REQUESTED)
  reason           String
  requestedBy      String         @map("requested_by") @db.Uuid
  decidedBy        String?        @map("decided_by") @db.Uuid
  decidedAt        DateTime?      @map("decided_at") @db.Timestamptz(6)
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(6)
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, assetId, status])
  @@map("transfer_requests")
}

model ReturnRequest {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  allocationId String       @map("allocation_id") @db.Uuid
  assetId      String       @map("asset_id") @db.Uuid
  status       ReturnStatus @default(RETURN_REQUESTED)
  requestedBy  String       @map("requested_by") @db.Uuid
  inspectedBy  String?      @map("inspected_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, assetId, status])
  @@map("return_requests")
}

model Resource {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  resourceType   ResourceType @map("resource_type")
  linkedAssetId  String?      @map("linked_asset_id") @db.Uuid
  locationId     String?      @map("location_id") @db.Uuid
  capacity       Int?
  bookingPolicy  Json         @default("{}") @map("booking_policy")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, resourceType, active])
  @@map("resources")
}

model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  resourceId            String        @map("resource_id") @db.Uuid
  bookedBy              String        @map("booked_by") @db.Uuid
  bookedForEmployeeId   String?       @map("booked_for_employee_id") @db.Uuid
  bookedForDepartmentId String?       @map("booked_for_department_id") @db.Uuid
  startAt               DateTime      @map("start_at") @db.Timestamptz(6)
  endAt                 DateTime      @map("end_at") @db.Timestamptz(6)
  timezone              String
  purpose               String
  status                BookingStatus @default(UPCOMING)
  cancelledAt           DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  version               Int           @default(1)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, resourceId, startAt, endAt])
  @@index([tenantId, status])
  @@map("bookings")
}

model ResourceBlackout {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startAt    DateTime @map("start_at") @db.Timestamptz(6)
  endAt      DateTime @map("end_at") @db.Timestamptz(6)
  reason     String
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, resourceId, startAt, endAt])
  @@map("resource_blackouts")
}

model MaintenanceRequest {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  assetId     String            @map("asset_id") @db.Uuid
  requestedBy String            @map("requested_by") @db.Uuid
  approvedBy  String?           @map("approved_by") @db.Uuid
  assignedTo  String?           @map("assigned_to") @db.Uuid
  status      MaintenanceStatus @default(PENDING)
  priority    String            @default("NORMAL")
  summary     String
  description String
  resolution  String?
  conditionAfterRepair AssetCondition? @map("condition_after_repair")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, assetId, status])
  @@map("maintenance_requests")
}

model AuditCycle {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  name      String
  status    AuditCycleStatus @default(DRAFT)
  scope     Json             @default("{}")
  startsAt  DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime         @map("ends_at") @db.Timestamptz(6)
  createdBy String           @map("created_by") @db.Uuid
  closedBy  String?          @map("closed_by") @db.Uuid
  closedAt  DateTime?        @map("closed_at") @db.Timestamptz(6)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@map("audit_cycles")
}

model AuditItem {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  auditCycleId    String           @map("audit_cycle_id") @db.Uuid
  assetId         String           @map("asset_id") @db.Uuid
  expectedSnapshot Json            @map("expected_snapshot")
  result          AuditItemResult?
  actualSnapshot  Json?            @map("actual_snapshot")
  observedBy      String?          @map("observed_by") @db.Uuid
  observedAt      DateTime?        @map("observed_at") @db.Timestamptz(6)
  version         Int              @default(1)

  @@unique([auditCycleId, assetId])
  @@index([tenantId, auditCycleId])
  @@map("audit_items")
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  recipientId String             @map("recipient_id") @db.Uuid
  channel     String
  title       String
  body        String
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime?          @map("delivered_at") @db.Timestamptz(6)

  @@unique([eventId, recipientId, channel])
  @@index([tenantId, recipientId, status])
  @@map("notifications")
}

model ActivityLog {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  actorId           String?  @map("actor_id") @db.Uuid
  actorRoleSnapshot Json     @map("actor_role_snapshot")
  action            String
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id") @db.Uuid
  beforeSummary     Json?    @map("before_summary")
  afterSummary      Json?    @map("after_summary")
  requestId         String   @map("request_id")
  ipHash            String?  @map("ip_hash")
  userAgent         String?  @map("user_agent")
  reason            String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId, createdAt])
  @@map("activity_logs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model ProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([eventId, consumer])
  @@map("processed_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  commandName    String   @map("command_name")
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ExportJob {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  requestedBy  String          @map("requested_by") @db.Uuid
  reportType   String          @map("report_type")
  format       String
  parameters   Json            @default("{}")
  status       ExportJobStatus @default(REQUESTED)
  objectKey    String?         @map("object_key")
  asOf         DateTime        @map("as_of") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  expiresAt    DateTime?       @map("expires_at") @db.Timestamptz(6)

  @@index([tenantId, requestedBy, status])
  @@map("export_jobs")
}
