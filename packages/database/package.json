{
  "name": "@assetflow/database",
  "version": "0.0.1",
  "private": true,
  "description": "Prisma client, schema, and migration helpers for AssetFlow",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "@assetflow/eslint-config": "workspace:*",
    "@assetflow/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "prisma": "^5.14.0",
    "typescript": "^5.5.2"
  }
}
