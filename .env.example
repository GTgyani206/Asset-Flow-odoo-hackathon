# AssetFlow – Environment Variable Reference
# Copy this file to .env and fill in your local values.
# NEVER commit the real .env file to version control.
# All secrets in production are managed outside this repository.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assetflow_dev
POSTGRES_USER=assetflow
POSTGRES_PASSWORD=change_me_locally

DATABASE_URL="postgresql://assetflow:change_me_locally@localhost:5432/assetflow_dev"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=        # leave empty for local dev; set in production secrets

# ---------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO for local dev)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=assetflow-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_me_locally

# ---------------------------------------------------------------------------
# API Application
# ---------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=/api
NODE_ENV=development

# ---------------------------------------------------------------------------
# Web Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Authentication (values below are placeholders – generate real secrets)
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Bootstrap (first-admin creation – used ONLY in the controlled mechanism)
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_SECRET=replace_with_a_different_long_random_string

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
OTEL_SERVICE_NAME=assetflow-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
